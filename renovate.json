{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update tool versions annotated with a '# renovate:' comment",
      "managerFilePatterns": ["/^Makefile$/", "/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+(?:[A-Z_]+=|version:\\s*)(?<currentValue>\\S+)"
      ]
    }
  ]
}
